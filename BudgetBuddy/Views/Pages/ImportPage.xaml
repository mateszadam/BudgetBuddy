<UserControl x:Class="BudgetBuddy.Views.Pages.ImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BudgetBuddy.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FF181818">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="15">
            <Button Content="  File megnyitása  " 
                Style="{StaticResource AccentButton}" 
                Click="BtnOpen_Click" 
                Cursor="Hand"/>
            <TextBlock x:Name="TxtFileName" 
                   VerticalAlignment="Center" 
                   Margin="10,0" 
                   Foreground="#FF00FF66" 
                   FontWeight="SemiBold"
                   Text="Nincs file kiválasztva..."/>
        </StackPanel>

        <Border x:Name="ConfigPanel" 
            Grid.Row="1" 
            Margin="15,0,15,5" 
            Visibility="Visible">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,5">
                    <TextBlock Text="Címsor: " 
                           Foreground="#FF00FF66" 
                           VerticalAlignment="Center" 
                           FontSize="14"/>
                    <TextBox x:Name="TxtHeaderRow" 
                         Style="{StaticResource ModernTextBox}" 
                         Text="0" 
                         Width="40"
                         Margin="10,0" 
                         Padding="2"
                         HorizontalContentAlignment="Center"
                         TextChanged="TxtHeaderRow_TextChanged"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Ár:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbMapAmount" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Devizanem:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbMapCurr" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Dátum:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbMapDate" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="5">
                        <TextBlock Text="Leírás:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbMapDesc" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="5">
                        <TextBlock Text="Típus:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbMapType" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="15,0" BorderBrush="#FF2C2C2C" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="GridPreview" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  CanUserAddRows="False"
                  HeadersVisibility="Row"
                  LoadingRow="PreviewGrid_LoadingRow"
                  Background="#FF101010"
                  RowBackground="#FF181818"
                  Foreground="#FF00FF66"
                  HorizontalGridLinesBrush="#FF2C2C2C"
                  VerticalGridLinesBrush="#FF2C2C2C"
                  BorderThickness="0">
                <DataGrid.RowHeaderStyle>
                    <Style TargetType="DataGridRowHeader">
                        <Setter Property="Background" Value="#FF202020"/>
                        <Setter Property="Foreground" Value="#FF00FF66"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="BorderBrush" Value="#FF2C2C2C"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.RowHeaderStyle>
            </DataGrid>
        </Border>

        <Button x:Name="BtnProcess" 
            Grid.Row="3" 
            Content="Adatok importálása" 
            Style="{StaticResource AccentButton}"
            Click="BtnProcess_Click" 
            Height="30"
            Width="180"
            Margin="10" 
            FontSize="18"
            IsEnabled="False"
            Cursor="Hand"/>
    </Grid>
</UserControl>
