<UserControl x:Class="BudgetBuddy.Views.Pages.ImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#FF181818">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="15">
            <Button Content="Fájl megnyitása" 
                    Style="{StaticResource AccentButton}" 
                    Click="OnOpenFileClick" 
                    Cursor="Hand"/>
            
            <TextBlock VerticalAlignment="Center" 
                       Margin="10,0" 
                       Foreground="#FF00FF66" 
                       FontWeight="SemiBold"
                       Text="{Binding FileNameText}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="15,0,15,5" 
                Visibility="{Binding IsConfigVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,5">
                    <TextBlock Text="Címsor:" 
                               Foreground="#FF00FF66" 
                               VerticalAlignment="Center" 
                               FontSize="14"/>
                    <TextBox Style="{StaticResource ModernTextBox}" 
                             Text="{Binding HeaderRowIndex, UpdateSourceTrigger=PropertyChanged}" 
                             Width="40"
                             Margin="10,0" 
                             Padding="2"
                             HorizontalContentAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Ár:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableColumns}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedAmountColumn, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Devizanem:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableColumns}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCurrencyColumn, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Dátum:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableColumns}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedDateColumn, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="5">
                        <TextBlock Text="Leírás:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableColumns}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedDescriptionColumn, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="5">
                        <TextBlock Text="Típus:" Foreground="#FF00FF66" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableColumns}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedTypeColumn, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="15,0" BorderBrush="#FF2C2C2C" BorderThickness="1" CornerRadius="8">
            <DataGrid ItemsSource="{Binding PreviewData}"
                      AutoGenerateColumns="True" 
                      IsReadOnly="True" 
                      CanUserAddRows="False"
                      HeadersVisibility="Row"
                      Background="#FF101010"
                      RowBackground="#FF181818"
                      Foreground="#FF00FF66"
                      HorizontalGridLinesBrush="#FF2C2C2C"
                      VerticalGridLinesBrush="#FF2C2C2C"
                      BorderThickness="0">
                 <DataGrid.RowHeaderStyle>
                    <Style TargetType="DataGridRowHeader">
                        <Setter Property="Background" Value="#FF202020"/>
                        <Setter Property="Foreground" Value="#FF00FF66"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="BorderBrush" Value="#FF2C2C2C"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.RowHeaderStyle>
            </DataGrid>
        </Border>

        <Button Grid.Row="3" 
                Content="Adatok importálása" 
                Style="{StaticResource AccentButton}"
                Command="{Binding ProcessDataCommand}"
                Height="30"
                Width="180"
                Margin="10" 
                FontSize="18"
                Cursor="Hand"/>
    </Grid>
</UserControl>